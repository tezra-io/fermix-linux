# The toolchain that compiles the private GTK runtime. It is not the runtime.
#
# `desktop/packaging/runtime/build_runtime.sh --container` builds this image,
# copies the build scripts and the locked source tarballs into a container made
# from it, and runs `build_runtime.sh --build` there. The compile is a container
# run rather than an image layer, so a failed component resumes instead of
# starting over, and the prefix lands in a named volume.
#
# AlmaLinux 9 is the base because glibc 2.34 is the lowest floor that covers
# RHEL 9 and Ubuntu 22.04 in one build, and building against the oldest host
# headers in the matrix keeps the host half of the boundary forward compatible.
# It is pinned by digest, as RUNTIME.lock.json records it.
FROM almalinux@sha256:9819dc675b67b595c2b59e42be7763fca1a8bb217fa5944e04daa22e9a64db16

ARG MESON_VERSION=1.12.1
ARG NINJA_VERSION=1.13.2
ARG PATCHELF_VERSION=0.18.0
ARG PATCHELF_SHA256=1952b2a782ba576279c211ee942e341748fdb44997f704dd53def46cd055470b
ARG LIBSASS_VERSION=3.6.6
ARG LIBSASS_SHA256=11f0bb3709a4f20285507419d7618f3877a425c0131ea8df40fe6196129df15d
ARG SASSC_VERSION=3.6.2
ARG SASSC_SHA256=608dc9002b45a91d11ed59e352469ecc05e4f58fc1259fc9a9f5b8f0f8348a03
ARG RUSTUP_VERSION=1.29.1
ARG RUSTUP_SHA256_X86_64=dda7234360b7f578ca8b0ddcb80145646fa61a67c1720a5abc7051b35c9fcb71
ARG RUSTUP_SHA256_AARCH64=15f6e4ce9f583b929c996c91562bad6d4454f3281de858b02cdfdef615fac433
ARG RUST_VERSION=1.97.1
# The cargo-c release that embeds cargo 0.98, the cargo Rust 1.97 ships.
ARG CARGO_C_VERSION=0.10.24+cargo-0.98.0

ENV CARGO_HOME=/usr/local/cargo \
    RUSTUP_HOME=/usr/local/rustup \
    PATH=/usr/local/cargo/bin:$PATH

# The compilers and build tools; the development headers of every library on
# the host side of the boundary, which are the only ones the build may link
# without carrying a copy; and the utilities the scripts use. No GLib, GTK,
# pango, cairo or GStreamer headers: those are built here, and a host copy would
# be a way to link the host's without anyone noticing.
#
# Two host packages drag in private ones: pulseaudio-libs-devel requires
# glib2-devel for its glib main loop, which brings libffi, pcre2, sysprof,
# libmount and libselinux headers, and libxkbcommon-devel requires
# libxml2-devel for xkbregistry. Neither part is used, so those packages are
# removed again, and the next step fails if any .pc file of a private component
# is left on the host (private-pc-check).
#
# openssl-devel is for compiling cargo-c below; nothing in the runtime links
# libssl, and the boundary gate would refuse it.
#
# shared-mime-info is a build tool: GTK's install step runs update-mime-database
# on the prefix. The database it writes is pruned from the shipped tree, since
# GIO reads the host's through XDG_DATA_DIRS.
#
# `--allowerasing` swaps the base image's curl-minimal for the full libcurl that
# libcurl-devel needs. Python 3.12 is beside the base's 3.9 because the pinned
# Meson needs 3.10 or later.
RUN dnf -y install dnf-plugins-core \
    && dnf config-manager --set-enabled crb \
    && dnf -y install --allowerasing --setopt=install_weak_deps=False \
      gcc gcc-c++ make cmake patch perl-interpreter \
      python3 python3.12 python3.12-pip \
      pkgconf-pkg-config gettext gperf nasm flex bison jq itstool shared-mime-info \
      autoconf automake libtool \
      curl tar xz bzip2 gzip findutils diffutils which binutils \
      zlib-devel libcurl-devel libyaml-devel openssl-devel \
      mesa-libGL-devel mesa-libEGL-devel mesa-libgbm-devel libdrm-devel \
      libX11-devel libxcb-devel libXext-devel libXi-devel libXcursor-devel \
      libXdamage-devel libXfixes-devel libXrandr-devel libXinerama-devel \
      libXrender-devel libxkbcommon-devel dbus-devel pulseaudio-libs-devel \
    && rpm -e --nodeps glib2-devel libxml2-devel libffi-devel pcre2-devel sysprof-capture-devel \
         libmount-devel libblkid-devel libselinux-devel libsepol-devel \
    && dnf clean all \
    && rm -rf /var/cache/dnf \
    && mkdir -p /workspace /sources

# private-pc-check: grep exits 1 when nothing matches, which is the pass; any
# other failure, of find or of grep, fails the step.
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
RUN found="$(find /usr/lib64/pkgconfig /usr/share/pkgconfig -name '*.pc' -printf '%f\n' \
      | { grep -xE '(glib|gobject|gio|gio-unix|gmodule|gthread)-2\.0\.pc|libffi\.pc|libpcre2-8\.pc|libxml-2\.0\.pc|expat\.pc|libpng(16)?\.pc|libjpeg\.pc|libtiff-4\.pc|libwebp\.pc|freetype2\.pc|fribidi\.pc|pixman-1\.pc|fontconfig\.pc|harfbuzz\.pc|cairo\.pc|pango\.pc|graphene-1\.0\.pc|gdk-pixbuf-2\.0\.pc|xmlb\.pc|appstream\.pc|wayland-client\.pc|wayland-protocols\.pc|epoxy\.pc|gtk4\.pc|libadwaita-1\.pc|gstreamer-1\.0\.pc|absl_base\.pc|webrtc-audio-processing-2\.pc' \
          || [ $? -eq 1 ]; })" \
    && if [ -n "$found" ]; then echo "private-pc-check: host .pc files of private components:" $found >&2; exit 1; fi \
    && echo "private-pc-check: no private component's .pc file is on the host"

# Meson and Ninja are pinned rather than taken from the distribution: several
# components need a newer Meson than AlmaLinux 9 ships, and a build tool that
# moves with the base image is a build that moves.
RUN python3.12 -m pip install --no-cache-dir \
      "meson==${MESON_VERSION}" "ninja==${NINJA_VERSION}" \
    && meson --version && ninja --version

# patchelf writes the RUNPATH of every shipped object. It is built from a
# digest-checked tarball rather than taken from EPEL, a moving repository.
RUN set -eux; \
    curl --proto '=https' --tlsv1.2 -fsSL \
      "https://github.com/NixOS/patchelf/releases/download/${PATCHELF_VERSION}/patchelf-${PATCHELF_VERSION}.tar.bz2" \
      -o /tmp/patchelf.tar.bz2; \
    echo "${PATCHELF_SHA256}  /tmp/patchelf.tar.bz2" | sha256sum -c -; \
    mkdir -p /tmp/patchelf; \
    tar -xjf /tmp/patchelf.tar.bz2 -C /tmp/patchelf --strip-components=1; \
    cd /tmp/patchelf; \
    ./configure --prefix=/usr/local; \
    make -j"$(nproc)"; \
    make install; \
    cd /; \
    rm -rf /tmp/patchelf /tmp/patchelf.tar.bz2; \
    patchelf --version

# GTK and libadwaita tarballs carry SCSS, not CSS, and compile it with sassc.
# Without it libadwaita would fetch its own sassc subproject mid-build. AlmaLinux
# 9 packages neither sassc nor libsass, so both are built from digest-checked
# tarballs. They are build tools: nothing they produce is linked.
RUN set -eux; \
    for pair in "libsass ${LIBSASS_VERSION} ${LIBSASS_SHA256}" \
                "sassc ${SASSC_VERSION} ${SASSC_SHA256}"; do \
      set -- $pair; name="$1"; version="$2"; sum="$3"; \
      curl --proto '=https' --tlsv1.2 -fsSL \
        "https://github.com/sass/${name}/archive/refs/tags/${version}.tar.gz" \
        -o "/tmp/${name}.tar.gz"; \
      echo "${sum}  /tmp/${name}.tar.gz" | sha256sum -c -; \
      mkdir -p "/tmp/${name}"; \
      tar -xzf "/tmp/${name}.tar.gz" -C "/tmp/${name}" --strip-components=1; \
      ( cd "/tmp/${name}" && autoreconf -fi \
        && ./configure --prefix=/usr/local --disable-static \
        && make -j"$(nproc)" && make install ); \
    done; \
    echo /usr/local/lib > /etc/ld.so.conf.d/usr-local.conf; \
    ldconfig; \
    rm -rf /tmp/libsass /tmp/sassc /tmp/libsass.tar.gz /tmp/sassc.tar.gz; \
    sassc --version

# librsvg, the SVG loader behind the image loader, is Rust. rustup-init is
# pinned by version and digest, and rustup checks every component of the pinned
# toolchain against the channel manifest.
RUN set -eu; \
    case "$(uname -m)" in \
      x86_64) digest="${RUSTUP_SHA256_X86_64}" ;; \
      aarch64) digest="${RUSTUP_SHA256_AARCH64}" ;; \
      *) echo "no rustup-init digest for $(uname -m)" >&2; exit 1 ;; \
    esac; \
    curl --proto '=https' --tlsv1.2 -fsSL -o /tmp/rustup-init \
      "https://static.rust-lang.org/rustup/archive/${RUSTUP_VERSION}/$(uname -m)-unknown-linux-gnu/rustup-init"; \
    echo "${digest}  /tmp/rustup-init" | sha256sum -c -; \
    chmod 0755 /tmp/rustup-init; \
    /tmp/rustup-init -y --no-modify-path --profile minimal --default-toolchain "${RUST_VERSION}"; \
    rm /tmp/rustup-init; \
    rustc --version; cargo --version

# librsvg's meson build drives its Rust half through `cargo cbuild`, so cargo-c
# is a build tool here: nothing it produces is linked. --locked takes the
# crate's own Cargo.lock, whose checksums cargo verifies.
RUN cargo install cargo-c --version "${CARGO_C_VERSION}" --locked \
    && rm -rf "$CARGO_HOME/registry" "$CARGO_HOME/git" \
    && cargo cbuild --version

WORKDIR /workspace
