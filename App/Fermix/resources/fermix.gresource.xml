    <file alias="oauth_clients/google-dark.png">VendorMarks/oauth_clients/google-dark.png</file>
    <file alias="oauth_clients/google-light.png">VendorMarks/oauth_clients/google-light.png</file>
    <file alias="plugins/agentmail-color.png">VendorMarks/plugins/agentmail-color.png</file>
    <file compressed="true" alias="plugins/discord-color.svg">VendorMarks/plugins/discord-color.svg</file>
    <file compressed="true" alias="plugins/eden-color.svg">VendorMarks/plugins/eden-color.svg</file>
