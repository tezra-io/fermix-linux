    <file compressed="true" alias="channels/signal-white.svg">VendorMarks/channels/signal-white.svg</file>
    <file alias="channels/slack-color.png">VendorMarks/channels/slack-color.png</file>
    <file compressed="true" alias="channels/telegram-color.svg">VendorMarks/channels/telegram-color.svg</file>
    <file alias="channels/whatsapp-color.webp">VendorMarks/channels/whatsapp-color.webp</file>
    <file compressed="true" alias="features/computer-history-color.svg">VendorMarks/features/computer-history-color.svg</file>
