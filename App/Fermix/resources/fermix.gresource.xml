<?xml version="1.0" encoding="UTF-8"?>
<!--
  One bundle. The icon entries follow the icon theme's own directory shape, so
  gtk::IconTheme::add_resource_path("/io/tezra/Fermix/icons") finds the
  application icon and its symbolic pair by name.
-->
<gresources>
  <gresource prefix="/io/tezra/Fermix">
    <file compressed="true" alias="style.css">style.css</file>
  </gresource>
  <gresource prefix="/io/tezra/Fermix/icons/scalable/apps">
    <file compressed="true" alias="io.tezra.Fermix.svg">icons/io.tezra.Fermix.svg</file>
  </gresource>
  <gresource prefix="/io/tezra/Fermix/icons/symbolic/apps">
    <file compressed="true" alias="io.tezra.Fermix-symbolic.svg">icons/io.tezra.Fermix-symbolic.svg</file>
    <file compressed="true" alias="fermix-progress-symbolic.svg">icons/fermix-progress-symbolic.svg</file>
  </gresource>
  <gresource prefix="/io/tezra/Fermix/brand">
    <file alias="fermix-mascot.png">brand/fermix-mascot.png</file>
    <file compressed="true" alias="fermix-wordmark.svg">brand/fermix-wordmark.svg</file>
  </gresource>
  <!--
    The vendor marks, byte for byte as the vendors publish them and as
    PROVENANCE.json records them. A mark is drawn from this bundle and never
    recoloured, so the bytes a reviewer hashes are the bytes a person sees.
  -->
  <gresource prefix="/io/tezra/Fermix/marks">
    <file compressed="true" alias="channels/discord-black.svg">VendorMarks/channels/discord-black.svg</file>
    <file compressed="true" alias="channels/discord-blurple.svg">VendorMarks/channels/discord-blurple.svg</file>
    <file compressed="true" alias="channels/discord-white.svg">VendorMarks/channels/discord-white.svg</file>
