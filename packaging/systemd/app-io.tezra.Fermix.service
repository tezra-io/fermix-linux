# The interface's own activation unit, and only the interface's
# (M38 sections 2.2, 5.3).
#
# It starts the window. It does not start, stop, supervise or know about the
# engine: the engine's vendor unit is fermix.service, which the fermix package
# owns and the packaged command line reconciles. An application that owned the
# engine's lifecycle is the arrangement M38 section 1 exists to delete.
#
# Type=dbus with BusName= is what lets the bus activate it: systemd starts the
# process, the process takes the name, and the activation completes.
[Unit]
Description=Fermix
Documentation=https://fermix.ai
PartOf=graphical-session.target

[Service]
Type=dbus
BusName=io.tezra.Fermix
ExecStart=/usr/bin/fermix-desktop --gapplication-service
Restart=no
Slice=app.slice
